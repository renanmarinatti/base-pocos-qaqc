# Normaliza fim de linha: LF no repositório, sempre.
# Necessário porque o devcontainer roda Linux — script shell com CRLF não executa lá.
* text=auto eol=lf

# Binários não devem ser tocados
*.png binary
*.jpg binary
*.webp binary
*.pdf binary
*.woff2 binary
*.ttf binary
*.gpkg binary
*.tif binary
